    "basePath": "/api/v1",
    "paths": {
        "/applications": {
            "get": {
                "security": [
                    {
                        "BasicAuth": []
                    }
                ],
                "description": "Fetches all applications associated with the authenticated user.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Applications"
                ],
                "summary": "Get user applications",
                "responses": {
                    "200": {
                        "description": "List of applications",
                        "schema": {
                            "type": "array",
                            "items": {
                                "$ref": "#/definitions/models.Application"
                            }
                        }
                    },
                    "401": {
                        "description": "Unauthorized, user ID not found in context",
                        "schema": {
                            "$ref": "#/definitions/models.ErrorResponse"
                        }
                    },
                    "404": {
                        "description": "No applications found for this user",
                        "schema": {
                            "$ref": "#/definitions/models.ErrorResponse"
                        }
                    },
                    "500": {
                        "description": "Failed to fetch applications",
                        "schema": {
                            "$ref": "#/definitions/models.ErrorResponse"
                        }
                    }
                }
            },
            "post": {
                "security": [
                    {
                        "BasicAuth": []
                    }
                ],
                "description": "Submits a draft application after validating its completeness.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Applications"
                ],
                "summary": "Submit application",
                "parameters": [
                    {
                        "description": "Submit application request",
                        "name": "request",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/models.SubmitExistingApplicationRequest"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Application submitted successfully",
                        "schema": {
                            "$ref": "#/definitions/models.SuccessResponse"
                        }
                    },
                    "400": {
                        "description": "Invalid request or application is incomplete",
                        "schema": {
                            "$ref": "#/definitions/models.ErrorResponse"
                        }
                    },
                    "401": {
                        "description": "Unauthorized, user ID not found in context",
                        "schema": {
                            "$ref": "#/definitions/models.ErrorResponse"
                        }
                    },
                    "404": {
                        "description": "Application not found",
                        "schema": {
                            "$ref": "#/definitions/models.ErrorResponse"
                        }
                    },
                    "500": {
                        "description": "Failed to submit application",
                        "schema": {
                            "$ref": "#/definitions/models.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/applications/init-application": {
            "post": {
                "security": [
                    {
                        "BasicAuth": []
                    }
                ],
                "description": "Creates a new draft application for a specific scheme.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Applications"
                ],
                "summary": "Initialize application",
                "parameters": [
                    {
                        "description": "Initialize application request",
                        "name": "request",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/models.InitApplicationRequest"
                        }
                    }
                ],
                "responses": {
                    "201": {
                        "description": "Application initialized successfully",
                        "schema": {
                            "$ref": "#/definitions/models.SuccessResponse"
                        }
                    },
                    "400": {
                        "description": "Invalid request",
                        "schema": {
                            "$ref": "#/definitions/models.ErrorResponse"
                        }
                    },
                    "401": {
                        "description": "Unauthorized, user ID not found in context",
                        "schema": {
                            "$ref": "#/definitions/models.ErrorResponse"
                        }
                    },
                    "404": {
                        "description": "Scheme not found",
                        "schema": {
                            "$ref": "#/definitions/models.ErrorResponse"
                        }
                    },
                    "409": {
                        "description": "Application already exists",
                        "schema": {
                            "$ref": "#/definitions/models.ErrorResponse"
                        }
                    },
                    "500": {
                        "description": "Failed to initialize application",
                        "schema": {
                            "$ref": "#/definitions/models.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/applications/status/{id}": {
            "get": {
                "security": [
                    {
                        "BasicAuth": []
                    }
                ],
                "description": "Fetches the status of an application based on the application ID and the authenticated user's ID.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Applications"
                ],
                "summary": "Get application status",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Application ID",
                        "name": "id",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Application status fetched successfully",
                        "schema": {
                            "$ref": "#/definitions/models.SuccessResponse"
                        }
                    },
                    "401": {
                        "description": "Unauthorized, user ID not found in context",
                        "schema": {
                            "$ref": "#/definitions/models.ErrorResponse"
                        }
                    },
                    "404": {
                        "description": "Application not found",
                        "schema": {
                            "$ref": "#/definitions/models.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/applications/withdraw-application": {
            "post": {
                "security": [
                    {
                        "BasicAuth": []
                    }
                ],
                "description": "Withdraws a submitted application and marks it as a draft.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Applications"
                ],
                "summary": "Withdraw application",
                "parameters": [
                    {
                        "description": "Withdraw application request",
                        "name": "request",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/models.SubmitExistingApplicationRequest"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Application withdrawn successfully",
                        "schema": {
                            "$ref": "#/definitions/models.SuccessResponse"
                        }
                    },
                    "400": {
                        "description": "Invalid request or application cannot be withdrawn",
                        "schema": {
                            "$ref": "#/definitions/models.ErrorResponse"
                        }
                    },
                    "401": {
                        "description": "Unauthorized, user ID not found in context",
                        "schema": {
                            "$ref": "#/definitions/models.ErrorResponse"
                        }
                    },
                    "404": {
                        "description": "Application not found",
                        "schema": {
                            "$ref": "#/definitions/models.ErrorResponse"
                        }
                    },
                    "500": {
                        "description": "Failed to withdraw application",
                        "schema": {
                            "$ref": "#/definitions/models.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/applications/{id}": {
            "patch": {
                "security": [
                    {
                        "BasicAuth": []
                    }
                ],
                "description": "Updates the details of a draft application, including the student profile and related data.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Applications"
                ],
                "summary": "Modify application",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Application ID",
                        "name": "id",
                        "in": "path",
                        "required": true
                    },
                    {
                        "description": "Modify application request",
                        "name": "request",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/models.StudentProfileInput"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Application modified successfully",
                        "schema": {
                            "$ref": "#/definitions/models.SuccessResponse"
                        }
                    },
                    "400": {
                        "description": "Invalid input",
                        "schema": {
                            "$ref": "#/definitions/models.ErrorResponse"
                        }
                    },
                    "401": {
                        "description": "Unauthorized, user ID not found in context",
                        "schema": {
                            "$ref": "#/definitions/models.ErrorResponse"
                        }
                    },
                    "403": {
                        "description": "Cannot modify application, it is already submitted",
                        "schema": {
                            "$ref": "#/definitions/models.ErrorResponse"
                        }
                    },
                    "404": {
                        "description": "Application not found",
                        "schema": {
                            "$ref": "#/definitions/models.ErrorResponse"
                        }
                    },
                    "500": {
                        "description": "Failed to update application",
                        "schema": {
                            "$ref": "#/definitions/models.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/schemes": {
            "get": {
                "description": "Fetch available schemes with pagination and filtering",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "scheme"
                ],
                "summary": "Get Schemes with pagination and filtering",
                "parameters": [
                    {
                        "type": "integer",
                        "default": 1,
                        "description": "Page number",
                        "name": "page",
                        "in": "query"
                    },
                    {
                        "type": "integer",
                        "default": 10,
                        "description": "Number of items per page",
                        "name": "limit",
                        "in": "query"
                    },
                    {
                        "type": "string",
                        "example": "Scholar Scheme",
                        "description": "Scheme name",
                        "name": "name",
                        "in": "query"
                    },
                    {
                        "type": "string",
                        "example": "upcoming",
                        "description": "Scheme status",
                        "name": "status",
                        "in": "query"
                    },
                    {
                        "type": "number",
                        "example": 1000,
                        "description": "Minimum amount",
                        "name": "min_amount",
                        "in": "query"
                    },
                    {
                        "type": "number",
                        "example": 5000,
                        "description": "Maximum amount",
                        "name": "max_amount",
                        "in": "query"
                    },
                    {
                        "type": "string",
                        "example": "2023-01-01T00:00:00Z",
                        "description": "Start after date (RFC3339 format)",
                        "name": "start_after",
                        "in": "query"
                    },
                    {
                        "type": "string",
                        "example": "2023-12-31T23:59:59Z",
                        "description": "End before date (RFC3339 format)",
                        "name": "end_before",
                        "in": "query"
                    },
                    {
                        "type": "string",
                        "description": "Eligible gender",
                        "name": "gender",
                        "in": "query"
                    },
                    {
                        "type": "string",
                        "description": "Academic qualification",
                        "name": "academic_qualification",
                        "in": "query"
                    },
                    {
                        "type": "number",
                        "description": "Income limit",
                        "name": "income_limit",
                        "in": "query"
                    },
                    {
                        "type": "string",
                        "description": "Category",
                        "name": "category",
                        "in": "query"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/models.SchemeResponse"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/models.ErrorResponse"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/models.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/schemes/{id}": {
            "get": {
                "description": "Get a specific scheme by its ID",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "scheme"
                ],
                "summary": "Get Scheme By ID",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Scheme ID",
                        "name": "id",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/models.Scheme"
                        }
                    },
                    "404": {
                        "description": "Not Found",
                        "schema": {
                            "$ref": "#/definitions/models.ErrorResponse"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/models.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/schemes/{id}/applications": {
            "get": {
                "description": "Get all the applications for a scheme by its ID",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "scheme"
                ],
                "summary": "Get all the applications for a scheme",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Scheme ID",
                        "name": "id",
                        "in": "path",
                        "required": true
                    },
                    {
                        "type": "string",
                        "example": "submitted",
                        "description": "Application status",
                        "name": "status",
                        "in": "query"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/models.SuccessResponse"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/models.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/schemes/{id}/status": {
            "get": {
                "description": "Get the current status of a scheme by its ID",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "scheme"
                ],
                "summary": "Get Scheme Status",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Scheme ID",
                        "name": "id",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/models.SuccessResponse"
                        }
                    },
                    "404": {
                        "description": "Not Found",
                        "schema": {
                            "$ref": "#/definitions/models.ErrorResponse"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/models.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/users": {
            "post": {
                "description": "Registers a new user with username and password",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "users"
                ],
                "summary": "Create a new user",
                "parameters": [
                    {
                        "description": "User create payload",
                        "name": "user",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/models.UserCreate"
                        }
                    }
                ],
                "responses": {
                    "201": {
                        "description": "Created",
                        "schema": {
                            "$ref": "#/definitions/models.User"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/models.ErrorResponse"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/models.ErrorResponse"
                        }
                    }
                }
            }
        }
    },
    "definitions": {
        "models.AcademicQualification": {
            "type": "string",
            "enum": [
                "None",
                "Class-X",
                "Class-XII",
                "Diploma",
                "Graduate",
                "Post-Graduate"
            ],
            "x-enum-varnames": [
                "AcademicQualificationNone",
                "AcademicQualificationClassX",
                "AcademicQualificationClassXII",
                "AcademicQualificationDiploma",
                "AcademicQualificationGraduate",
                "AcademicQualificationPostGraduate"
            ]
        },
        "models.Address": {
            "type": "object",
            "properties": {
                "city": {
                    "type": "string"
                },
                "country": {
                    "type": "string"
                },
                "created_at": {
                    "type": "string"
                },
                "pincode": {
                    "type": "string"
                },
                "state": {
                    "type": "string"
                },
                "street": {
                    "type": "string"
                },
                "type": {
                    "description": "permanent, current",
                    "type": "string"
                },
                "updated_at": {
                    "type": "string"
                }
            }
        },
        "models.AddressInput": {
            "type": "object",
            "properties": {
                "city": {
                    "type": "string",
                    "example": "Kolkata"
                },
                "country": {
                    "type": "string",
                    "example": "India"
                },
                "pincode": {
                    "type": "string",
                    "example": "700001"
                },
                "state": {
                    "type": "string",
                    "example": "West Bengal"
                },
                "street": {
                    "type": "string",
                    "example": "123 Main St"
                },
                "type": {
                    "description": "e.g., permanent, current",
                    "type": "string",
                    "example": "permanent"
                }
            }
        },
        "models.Application": {
            "type": "object",
            "properties": {
                "created_at": {
                    "type": "string"
                },
                "id": {
                    "type": "integer"
                },
                "is_draft": {
                    "type": "boolean"
                },
                "scheme_id": {
                    "type": "integer"
                },
                "status": {
                    "description": "status of the application (submitted, under review, approved, rejected)",
                    "type": "string"
                },
                "student_profile": {
                    "$ref": "#/definitions/models.StudentProfile"
                },
                "student_profile_id": {
                    "type": "integer"
                },
                "submitted_at": {
                    "type": "string"
                },
                "updated_at": {
                    "type": "string"
                },
                "user": {
                    "$ref": "#/definitions/models.User"
                },
                "user_id": {
                    "type": "integer"
                },
                "verified": {
                    "type": "boolean"
                }
            }
        },
        "models.Category": {
            "type": "string",
            "enum": [
                "General",
                "SC",
                "ST",
                "OBC",
                "Other"
            ],
            "x-enum-varnames": [
                "CategoryGeneral",
                "CategorySC",
                "CategoryST",
                "CategoryOBC",
                "CategoryOther"
            ]
        },
        "models.DocumentInput": {
            "type": "object",
            "properties": {
                "name": {
                    "type": "string",
                    "example": "Aadhaar Card"
                },
                "url": {
                    "type": "string",
                    "example": "https://example.com/documents/aadhaar_card.pdf"
                }
            }
        },
        "models.DocumentsRequired": {
            "type": "object",
            "properties": {
                "description": {
                    "type": "string"
                },
                "name": {
                    "description": "Unique constraint for the document name",
                    "type": "string"
                },
                "type": {
                    "type": "string"
                }
            }
        },
        "models.EducationHistoryInput": {
            "type": "object",
            "properties": {
                "course": {
                    "type": "string",
                    "example": "Physics"
                },
                "degree": {
                    "type": "string",
                    "example": "Bachelor of Science"
                },
                "grade": {
                    "type": "string",
                    "example": "First Class"
                },
                "university": {
                    "type": "string",
                    "example": "University of Calcutta"
                },
                "year_of_passing": {
                    "type": "integer",
                    "example": 2022
                }
            }
        },
        "models.Eligibility": {
            "type": "object",
            "properties": {
                "academic_qualification": {
                    "$ref": "#/definitions/models.AcademicQualification"
                },
                "age_max": {
                    "type": "integer"
                },
                "age_min": {
                    "type": "integer"
                },
                "category": {
                    "$ref": "#/definitions/models.Category"
                },
                "created_at": {
                    "type": "string"
                },
                "documents_required": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/models.EligibilityDocumentMap"
                    }
                },
                "gender": {
                    "$ref": "#/definitions/models.Gender"
                },
                "id": {
                    "type": "integer"
                },
                "income_limit": {
                    "type": "number"
                },
                "updated_at": {
                    "type": "string"
                }
            }
        },
        "models.EligibilityDocumentMap": {
            "type": "object",
            "properties": {
                "document": {
                    "$ref": "#/definitions/models.DocumentsRequired"
                },
                "id": {
                    "type": "integer"
                },
                "is_mandatory": {
                    "type": "boolean"
                }
            }
        },
        "models.ErrorResponse": {
            "type": "object",
            "properties": {
                "code": {
                    "type": "integer"
                },
                "error": {
                    "type": "string"
                },
                "message": {
                    "type": "string"
                }
            }
        },
        "models.Gender": {
            "type": "string",
            "enum": [
                "Male",
                "Female",
                "Other"
            ],
            "x-enum-varnames": [
                "GenderMale",
                "GenderFemale",
                "GenderOther"
            ]
        },
        "models.InitApplicationRequest": {
            "type": "object",
            "required": [
                "scheme_id"
            ],
            "properties": {
                "scheme_id": {
                    "type": "integer"
                }
            }
        },
        "models.PaginationMeta": {
            "type": "object",
            "properties": {
                "limit": {
                    "type": "integer",
                    "example": 10
                },
                "next": {
                    "type": "string",
                    "example": "/api/v1/schemes?limit=10\u0026page=11"
                },
                "page": {
                    "type": "integer",
                    "example": 10
                },
                "previous": {
                    "type": "string",
                    "example": "/api/v1/schemes?limit=10\u0026page=9"
                },
                "resource_count": {
                    "type": "integer",
                    "example": 200
                },
                "total_pages": {
                    "type": "integer",
                    "example": 20
                }
            }
        },
        "models.Scheme": {
            "type": "object",
            "properties": {
                "amount": {
                    "type": "number"
                },
                "application_link": {
                    "type": "string"
                },
                "created_at": {
                    "type": "string"
                },
                "description": {
                    "type": "string"
                },
                "eligibility": {
                    "$ref": "#/definitions/models.Eligibility"
                },
                "eligibility_id": {
                    "description": "foreign key to Eligibility",
                    "type": "integer"
                },
                "end_date": {
                    "type": "string"
                },
                "id": {
                    "type": "integer"
                },
                "name": {
                    "type": "string"
                },
                "start_date": {
                    "type": "string"
                },
                "status": {
                    "type": "string"
                },
                "updated_at": {
                    "type": "string"
                }
            }
        },
        "models.SchemeResponse": {
            "type": "object",
